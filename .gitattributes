# Blender 固定运行资源按清单校验原始字节；文本必须跨平台保持 LF。
src-tauri/resources/blender-runtime/**/*.json text eol=lf
src-tauri/resources/blender-runtime/**/*.py text eol=lf
src-tauri/resources/blender-runtime/**/*.blend binary

# MCP 和 CLI Node 入口包含 shebang，固定 LF 以兼容 Windows 测试模块加载。
scripts/ai-canvas-mcp.mjs text eol=lf
scripts/ai-canvas-cli.mjs text eol=lf

# Git hooks 包含 shebang，固定 LF 以便跨平台执行。
scripts/pre-commit text eol=lf
scripts/pre-push text eol=lf
